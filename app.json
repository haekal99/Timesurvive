{
  "expo": {
    "name": "TimeSurvive",
    "slug": "TimeSurvive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/timesurvive-icon.png",
    "scheme": "timesurvive",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/timesurvive-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080711",
        "foregroundImage": "./assets/images/timesurvive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.haekal99.TimeSurvive"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/timesurvive-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080711",
          "image": "./assets/images/timesurvive-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan TimeSurvive memilih foto untuk avatar profil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "18122c3d-6f44-4a66-bb29-c0881e9333e1"
      }
    }
  }
}
